# Rail Data Marketplace "Consumer key" for the Live Departure Board product.
# Leave empty to run without live data (search_stations still works).
RAILDATA_API_KEY=
# Only if the Service Details product uses a different key.
RAILDATA_SERVICE_API_KEY=

# Required for the HTTP transport on a non-loopback address. Generate one with:
#   openssl rand -base64 32
MCP_AUTH_TOKEN=

# Comma-separated browser origins allowed to call the HTTP endpoint (optional).
MCP_ALLOWED_ORIGINS=
